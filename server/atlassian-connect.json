{
  "key": "code-review-bot",
  "name": "Code Review Bot",
  "description": "A bot that reviews pull requests for code quality and security.",
  "baseUrl": "https://0548-2405-201-e048-7046-78f5-9f2d-bc1d-d94a.ngrok-free.app",
  "authentication": {
    "type": "jwt"
  },
  "lifecycle": {
    "installed": "/bitbucket/installed",
    "uninstalled": "/bitbucket/uninstalled"
  },
  "scopes": [
    "pullrequest",
    "pullrequest:write",
    "repository",
    "repository:write",
    "repository:admin",
    "project",
    "account",
    "webhook",
    "issue"
  ],
  "modules": {
    "webhooks": [
      {
        "event": "pullrequest:created",
        "url": "/bitbucket/webhook"
      }
    ]
  },
  "contexts": ["account"]
}
